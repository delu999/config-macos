alias code="open -a /Applications/VSCodium.app"
alias zed="open -a /Applications/Zed.app"
alias cl="claude --permission-mode bypassPermissions"
alias co="codex -a never"
alias ll="ls -lahFG"

export PATH="$HOME/.local/bin:$PATH"
export PATH="/Users/u:$PATH"

eval "$(mise activate zsh)"

source <(fzf --zsh)

eval "$(starship init zsh)"
eval "$(atuin init zsh)"

if [[ -n ${GHOSTTY_RESOURCES_DIR:-} || ${TERM_PROGRAM:-} == vscode ]]; then
  eval "$(zoxide init zsh --cmd cd)"
else
  eval "$(zoxide init zsh)"
fi
